# --- Font Settings ---
font-family = "UbuntuSansMono Nerd Font"
font-size = 14
font-style = Medium
adjust-icon-height = 25%

# --- Theme & Visuals ---
theme = Wez
background-opacity = 0.65
background-blur-radius = 20
# credit: github.com/sahaj-b/ghostty-cursor-shaders
custom-shader = shaders/cursor_warp_fast.glsl

# --- Window Layout ---
maximize = true
gtk-titlebar = false
window-decoration = none
window-padding-x = 0
window-padding-y = 0
window-save-state = always
quit-after-last-window-closed = true
confirm-close-surface = false

# --- Mouse & Cursor ---
cursor-style = bar
cursor-style-blink = false
adjust-cursor-thickness = 150%
copy-on-select = clipboard
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:0.1,discrete:3

# --- Key mappings ---
# Nvim tab switching
keybind = ctrl+tab=text:\x1b[9;5u
keybind = ctrl+shift+tab=text:\x1b[9;6u
# newline shell command - NOT WORKING
keybind = shift+enter=text:\x1b[200~\n\x1b[201~

